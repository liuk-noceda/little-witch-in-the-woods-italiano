<Window x:Class="LiukNoceda.LittleWitchManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Little Witch in the Woods in italiano"
        Height="650" Width="820" MinHeight="580" MinWidth="740"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

  <Grid>
    <Grid Margin="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ============================ Intestazione ========================= -->
      <Grid Grid.Row="0" Margin="38,28,38,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Image x:Name="LogoImage" Grid.Column="0" Width="52" Height="52" Margin="0,0,18,0"
               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Little Witch in the Woods" FontSize="26" FontWeight="Light"/>
          <TextBlock Margin="0,3,0,0">
            <Run Text="di " Foreground="{StaticResource Muted}" FontSize="12.5"/>
            <Run Text="Liuk Noceda" Foreground="{StaticResource Wisteria}"
                 FontSize="12.5" FontWeight="SemiBold"/>
            <Run Text=" · traduzione amatoriale, non ufficiale"
                 Foreground="{StaticResource Muted}" FontSize="12.5"/>
          </TextBlock>
        </StackPanel>

        <TextBlock Grid.Column="2" x:Name="VersionText" Text="v1.0.0" VerticalAlignment="Center"
                   Foreground="{StaticResource Muted}" FontSize="11.5"/>
      </Grid>

      <!-- ======================= Corpo: moduli e percorso ================== -->
      <Grid Grid.Row="1" Margin="38,24,38,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
          <StackPanel VerticalAlignment="Top">

            <TextBlock Text="Cosa vuoi installare" Style="{StaticResource Sub}"
                       Margin="2,0,0,12" FontSize="11.5"/>

            <!-- Modulo Traduzione -->
            <CheckBox x:Name="TransCheck" Style="{StaticResource ModuleCard}"
                      Checked="Module_Changed" Unchecked="Module_Changed">
              <StackPanel>
                <Grid>
                  <TextBlock Text="Traduzione italiana" FontSize="15.5" FontWeight="SemiBold"/>
                  <TextBlock x:Name="TransState" Text="" HorizontalAlignment="Right"
                             VerticalAlignment="Center" FontSize="11"
                             Foreground="{StaticResource Ok}"/>
                </Grid>
                <TextBlock Style="{StaticResource Sub}" Margin="0,7,0,0" LineHeight="18"
                           Text="Dialoghi, interfaccia, enciclopedia e descrizioni. Aggiunge «Italiano» al selettore di lingua del gioco senza sostituire l'inglese."/>
              </StackPanel>
            </CheckBox>

            <!-- Modulo Icone PlayStation -->
            <CheckBox x:Name="PadCheck" Style="{StaticResource ModuleCard}" Margin="0,12,0,0"
                      Checked="Module_Changed" Unchecked="Module_Changed">
              <StackPanel>
                <Grid>
                  <TextBlock Text="Icone PlayStation (DualSense)" FontSize="15.5" FontWeight="SemiBold"/>
                  <TextBlock x:Name="PadState" Text="" HorizontalAlignment="Right"
                             VerticalAlignment="Center" FontSize="11"
                             Foreground="{StaticResource Ok}"/>
                </Grid>
                <TextBlock Style="{StaticResource Sub}" Margin="0,7,0,0" LineHeight="18"
                           Text="Mostra i tasti PlayStation (Croce, Cerchio, Quadrato, Triangolo, L1/R1, L2/R2) per DualSense e controller Sony. Usa la grafica ufficiale del gioco."/>
              </StackPanel>
            </CheckBox>

            <!-- Riga percorso di gioco -->
            <Grid Margin="2,24,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" x:Name="PathIcon" Text="&#xE73E;" Style="{StaticResource Glyph}"
                         FontSize="13" Foreground="{StaticResource Ok}" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="1" x:Name="PathText" Style="{StaticResource Sub}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         TextWrapping="NoWrap" Text="Cerco Little Witch in the Woods…"/>
              <Button Grid.Column="2" x:Name="ChangePathButton" Style="{StaticResource LinkButton}"
                      Content="cambia" Click="ChangePath_Click" Margin="10,0,0,0"/>
            </Grid>

          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- =============================== Piede ============================= -->
      <Border Grid.Row="2" Background="#D9162016" BorderThickness="0,1,0,0"
              BorderBrush="#FF2E3C29" Padding="38,16" Margin="0,20,0,0">
        <StackPanel>
          <ProgressBar x:Name="Progress" Visibility="Collapsed" Margin="0,0,0,12"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="ApplyButton" Style="{StaticResource PrimaryButton}"
                    Padding="32,12" FontSize="13.5" Click="Apply_Click" Content="Installa"/>

            <TextBlock Grid.Column="1" x:Name="StatusText" Style="{StaticResource Sub}"
                       VerticalAlignment="Center" Margin="18,0,18,0"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="Pronto."/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="RemoveAllButton" Style="{StaticResource LinkButton}"
                      Content="rimuovi tutto" Click="RemoveAll_Click"/>
              <TextBlock Text="·" Foreground="{StaticResource Muted}" Margin="9,0"/>
              <Button x:Name="LogButton" Style="{StaticResource LinkButton}"
                      Content="log" Click="LogButton_Click"/>
              <TextBlock Text="·" Foreground="{StaticResource Muted}" Margin="9,0"/>
              <Button x:Name="InfoButton" Style="{StaticResource LinkButton}"
                      Content="crediti" Click="Info_Click"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ======================= Crediti: pannello sopra ===================== -->
    <Grid x:Name="InfoOverlay" Visibility="Collapsed" Background="#E6101610">
      <Border Style="{StaticResource Card}" MaxWidth="620" VerticalAlignment="Center"
              HorizontalAlignment="Center" Padding="34,28">
        <StackPanel>
          <TextBlock Text="Little Witch in the Woods in italiano" FontSize="20" FontWeight="Light"/>
          <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0"
                     Text="Traduzione italiana amatoriale di"/>
          <TextBlock Text="Liuk Noceda (Luca Nasi)" FontSize="18"
                     FontWeight="SemiBold" Foreground="{StaticResource Wisteria}" Margin="0,4,0,0"/>

          <Rectangle Height="1" Fill="#FF2E3C29" Margin="0,18,0,15"/>

          <TextBlock Style="{StaticResource Sub}" LineHeight="19"
                     Text="Progetto non affiliato a SUNNYSIDEUP. Richiede una copia del gioco. Tutti i diritti del gioco e della sua grafica appartengono ai rispettivi proprietari."/>
          <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0" LineHeight="19"
                     Text="Nessun file originale del gioco viene modificato: la patch agisce a runtime tramite BepInEx. «Rimuovi tutto» riporta il gioco esattamente com'era prima."/>
          <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0" LineHeight="19"
                     Text="Il modulo icone PlayStation attiva la grafica DualShock/DualSense già presente nel codice originale del gioco."/>

          <Rectangle Height="1" Fill="#FF2E3C29" Margin="0,16,0,14"/>

          <TextBlock Text="Componenti di terze parti" FontSize="13" FontWeight="SemiBold"/>
          <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" LineHeight="18"
                     Text="BepInEx 5.4.23.3 — LGPL-2.1 · HarmonyX — MIT · Newtonsoft.Json — MIT"/>

          <Button Style="{StaticResource BaseButton}" HorizontalAlignment="Right"
                  Margin="0,20,0,0" Content="Chiudi" Click="CloseInfo_Click"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
